# OpenFPM example Makefile
#
# This Makefile relies on the file `example.mk` that is generated by OpenFPM's
# helper script and placed in THIS directory:
#
#   ./script/create_example.mk.sh $PREFIX_DEPENDS $PREFIX_OPENFPM
#   mv example.mk example
#
# where $PREFIX_DEPENDS and $PREFIX_OPENFPM are the directories where you
# installed the OpenFPM dependencies and OpenFPM itself.

include example.mk

CXX ?= g++

# System MPI include path (OpenFPM's example.mk does not add it). Independent of
# example.mk, which OpenFPM may regenerate and overwrite.
MPI_INC = -I/usr/lib/x86_64-linux-gnu/openmpi/include
MPI_LIB = -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi -lmpi_cxx

# Runtime library search paths baked into the binary via rpath, so the example
# runs without needing LD_LIBRARY_PATH to be set. Independent of example.mk.
# --disable-new-dtags forces RPATH (not RUNPATH) so the paths are also searched
# for transitive dependencies (e.g. libparmetis.so -> libmetis.so).
RPATH = -Wl,--disable-new-dtags \
        -Wl,-rpath,$(HOME)/openfpm_dependencies/METIS/lib \
        -Wl,-rpath,$(HOME)/openfpm_dependencies/PARMETIS/lib \
        -Wl,-rpath,$(HOME)/openfpm_dependencies/BOOST/lib \
        -Wl,-rpath,$(HOME)/openfpm_dependencies/HDF5/lib \
        -Wl,-rpath,$(HOME)/openfpm_install/openfpm_devices/lib \
        -Wl,-rpath,$(HOME)/openfpm_install/openfpm_pdata/lib \
        -Wl,-rpath,$(HOME)/openfpm_install/openfpm_vcluster/lib \
        -Wl,-rpath,/usr/lib/x86_64-linux-gnu/openmpi/lib

main: main.cpp $(MAKEFILE_LIST)
	$(CXX) $(CFLAGS) -O3 main.cpp $(INCLUDE_PATH) $(MPI_INC) $(LIBS_PATH) $(LIBS) $(MPI_LIB) $(RPATH) -o main

# 3D torus (beautiful manifold) example
main3d: main3d.cpp $(MAKEFILE_LIST)
	$(CXX) $(CFLAGS) -O3 main3d.cpp $(INCLUDE_PATH) $(MPI_INC) $(LIBS_PATH) $(LIBS) $(MPI_LIB) $(RPATH) -o main3d

run: main
	mpirun -np 2 ./main

run3d: main3d
	mpirun -np 2 ./main3d

clean:
	rm -rf VTPDATA
	rm -f main main3d particles*.vtk particles*.vtu particles*.vtp particles*.pvtp torus*.vtu torus*.vtp torus*.pvtp torus*.pvd

.PHONY: run clean
